<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/text_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/text_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_input"
        android:clickable="true"
        android:elevation="14dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="8dp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="8dp">

        <View
            android:id="@+id/text_dot"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginEnd="10dp" />

        <EditText
            android:id="@+id/text_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/text_hint"
            android:imeOptions="actionDone|flagNoExtractUi"
            android:includeFontPadding="false"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:minHeight="34dp"
            android:paddingBottom="6dp"
            android:paddingTop="6dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textSize="15sp" />

        <FrameLayout
            android:id="@+id/text_cancel"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_ripple_round"
            android:clickable="true"
            android:contentDescription="@string/text_cancel"
            android:focusable="true">

            <ImageView
                android:id="@+id/text_cancel_icon"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_close" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/text_ok"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/bg_round_accent"
            android:clickable="true"
            android:contentDescription="@string/text_insert"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_check" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
